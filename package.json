{
  "name": "tnp-placement-management-system",
  "version": "1.0.0",
  "description": "Training & Placement (TNP) Management System - Full MERN Stack",
  "private": true,
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "audit:db": "npm --prefix backend run audit:db"
  },
  "keywords": ["mern", "placement-management", "tnp", "react", "nodejs", "express", "mongodb"]
}
