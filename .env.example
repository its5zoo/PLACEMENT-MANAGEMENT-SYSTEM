# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/tnp_database

# JWT Authentication Secrets
JWT_SECRET=super_secret_placement_management_jwt_key_2026
JWT_REFRESH_SECRET=super_secret_placement_refresh_key_2026
JWT_EXPIRE=7d

# Institution Details
INSTITUTION_NAME=Gandhi Institute of Engineering and Technology
INSTITUTION_DOMAIN=giet.edu

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Development-only header-based portal demo. Never enable in production.
ALLOW_DEMO_AUTH=false

# Frontend API origin for separate deployments, for example https://api.example.com/api
VITE_API_BASE_URL=/api
